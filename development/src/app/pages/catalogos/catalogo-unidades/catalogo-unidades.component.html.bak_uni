<div class="hoose-tabla-wrapper" style="margin: 16px 16px 0 0;">

  <!-- FAB flotante agregar -->
  <button *ngIf="permitirAgregarEditar" pButton type="button" icon="pi pi-plus" class="p-button-rounded p-button-raised hoose-fab" pTooltip="Nueva unidad" tooltipPosition="left" (click)="onUnidadEditar()"></button>

  <!-- Toolbar -->
  <div class="hoose-tabla-toolbar" style="align-items:flex-start;gap:16px;flex-wrap:nowrap">
    <div style="flex-shrink:0;max-width:70%">
    <div class="hoose-kpi-card hoose-kpi-blue" style="margin:0">
      <div class="hoose-kpi-icon"><i class="pi pi-home"></i></div>
      <div class="hoose-kpi-body">
        <span class="hoose-kpi-label">Total Unidades</span>
        <span class="hoose-kpi-value">{{ UnidadesFiltradas.length }}</span>
        <span class="hoose-kpi-sub">Activas: <b>{{ kpiActivos }}</b> &nbsp;|&nbsp; Inactivas: <b>{{ kpiInactivos }}</b></span>
      </div>
    </div>
    </div>
    <div class="d-flex flex-column gap-2 justify-content-between">
      <div class="d-flex justify-content-end">
      </div>
      <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
        <div class="hoose-tabla-search">
          <i class="pi pi-search"></i>
          <input type="text" placeholder="Buscar unidad..." (input)="ptUnidades.filterGlobal($event.target.value, 'contains')" />
        </div>
        <select *ngIf="esSuperAdminSinCondominio" class="hoose-filtro-select" [(ngModel)]="filtroCondominio">
          <option [ngValue]="null">Condominio</option>
          <option *ngFor="let c of condominiosLista" [ngValue]="c.value">{{ c.label }}</option>
        </select>
        <select class="hoose-filtro-select" [(ngModel)]="filtroTipo">
          <option [ngValue]="null">Tipo</option>
          <option *ngFor="let t of tiposUnidad" [ngValue]="t">{{ t }}</option>
        </select>
        <select class="hoose-filtro-select" [(ngModel)]="filtroModo">
          <option [ngValue]="null">Modo</option>
          <option ngValue="Vivienda">Vivienda</option>
          <option ngValue="Renta">Renta</option>
        </select>
        <select class="hoose-filtro-select" [(ngModel)]="filtroEstatus">
          <option [ngValue]="null">Estatus</option>
          <option [ngValue]="1">Activo</option>
          <option [ngValue]="0">Inactivo</option>
        </select>
        <button pButton type="button" icon="pi pi-times" class="hoose-btn-clear" pTooltip="Limpiar filtros" tooltipPosition="left" (click)="limpiarFiltros(); hlpPrimeNGTable.reset(ptUnidades)"></button>
      </div>
    </div>
  </div>

  <!-- Tabla -->
  <div class="hoose-tabla-container" style="overflow-x:auto">
    <p-table
      #ptUnidades
      [value]="UnidadesFiltradas"
      [globalFilterFields]="UnidadesFilter"
      [rowHover]="true"
      [showCurrentPageReport]="true"
      [paginator]="UnidadesFiltradas.length > 0"
      [rows]="20"
      dataKey="id_unidad"
      styleClass="hoose-table"
      currentPageReportTemplate="Mostrando {first} - {last} de {totalRecords}"
      [rowsPerPageOptions]="[10,20,50]"
    >
      <ng-template pTemplate="header">
        <tr>
          <th *ngIf="esSuperAdminSinCondominio" class="hoose-th" style="min-width:140px;white-space:nowrap">Condominio</th>
          <th class="hoose-th" style="min-width:160px;white-space:nowrap">Unidad</th>
          <th class="hoose-th" style="min-width:90px;white-space:nowrap">Superficie</th>
          <th class="hoose-th" style="min-width:110px;white-space:nowrap">Cuota Mtto</th>
          <th class="hoose-th" style="min-width:150px;white-space:nowrap">Edificio / Torre</th>
          <th class="hoose-th" style="min-width:110px;white-space:nowrap">Tipo</th>
          <th class="hoose-th text-center" style="min-width:70px;white-space:nowrap">Nivel</th>
          <th class="hoose-th" style="min-width:90px;white-space:nowrap">Modo</th>
          <th class="hoose-th" style="min-width:150px;white-space:nowrap">Propietario</th>
          <th class="hoose-th" style="min-width:150px;white-space:nowrap">Condómino</th>
          <th class="hoose-th text-center" style="min-width:90px;white-space:nowrap">Legal</th>
          <th class="hoose-th text-center" style="min-width:90px;white-space:nowrap">Estatus</th>
          <th class="hoose-th text-center" style="min-width:110px;white-space:nowrap">Acciones</th>
        </tr>
      </ng-template>
      <ng-template pTemplate="body" let-Unidad>
        <tr class="hoose-tr" (click)="onUnidadDetalles(Unidad)">
          <td *ngIf="esSuperAdminSinCondominio" class="hoose-td">
            <span class="hoose-cond-pill" [ngStyle]="{'color': getCondominioColor(Unidad.condominio_nombre), 'background': getCondominioColor(Unidad.condominio_nombre) + '18'}">{{ Unidad.condominio_nombre || '—' }}</span>
          </td>
          <td class="hoose-td"><strong class="hoose-nombre">{{ Unidad.unidad }}</strong></td>
          <td class="hoose-td"><span class="hoose-num">{{ Unidad.metros_cuadrados ? Unidad.metros_cuadrados + ' m²' : '—' }}</span></td>
          <td class="hoose-td"><span class="hoose-num">{{ Unidad.cuota_mantenimiento ? ('$' + Unidad.cuota_mantenimiento) : '—' }}</span></td>
          <td class="hoose-td">{{ Unidad.edificio || '—' }}</td>
          <td class="hoose-td"><span class="hoose-tipo-pill">{{ Unidad.tipo_unidad || 'Departamento' }}</span></td>
          <td class="hoose-td text-center"><span class="hoose-num">{{ Unidad.nivel || '—' }}</span></td>
          <td class="hoose-td"><span class="hoose-num">{{ Unidad.modo || 'Vivienda' }}</span></td>
          <td class="hoose-td"><span class="hoose-num">{{ Unidad.propietario_nombre || '—' }}</span></td>
          <td class="hoose-td"><span class="hoose-num">{{ Unidad.condomino_nombre || '—' }}</span></td>
          <td class="hoose-td text-center" (click)="$event.stopPropagation()">
            <i *ngIf="Unidad.escrituras_archivo" class="pi pi-file-pdf" style="color:#ef4444;cursor:pointer;font-size:1.1rem" pTooltip="Ver escrituras" tooltipPosition="top" (click)="onUnidadEscriturasMostrar(Unidad)"></i>
            <span *ngIf="!Unidad.escrituras_archivo" class="hoose-num">—</span>
          </td>
          <td class="hoose-td text-center">
            <span class="hoose-estatus-pill {{ Unidad.estatus == 1 ? 'activo' : 'inactivo' }}" style="cursor:pointer"
              (click)="$event.stopPropagation(); permitirAgregarEditar && onUnidadAlternarEstatus(Unidad)"
              pTooltip="{{ Unidad.estatus == 1 ? 'Deshabilitar' : 'Habilitar' }}" tooltipPosition="top">
              <span class="hoose-estatus-dot"></span>{{ Unidad.estatus == 1 ? 'Activa' : 'Inactiva' }}
            </span>
          </td>
          <td class="hoose-td text-center" (click)="$event.stopPropagation()">
            <button pButton type="button" icon="pi pi-eye" class="hoose-btn-accion" pTooltip="Ver detalles" tooltipPosition="top" (click)="onUnidadDetalles(Unidad)"></button>
            <button *ngIf="permitirAgregarEditar && Unidad.estatus == 1" pButton type="button" icon="pi pi-pencil" class="hoose-btn-accion" pTooltip="Editar" tooltipPosition="top" (click)="onUnidadEditar(Unidad)"></button>
            <button *ngIf="esSuperAdmin" pButton type="button" icon="pi pi-trash" class="hoose-btn-accion" style="color:#ef4444 !important" pTooltip="Eliminar" tooltipPosition="top" (click)="$event.stopPropagation(); onUnidadEliminar(Unidad)"></button>
          </td>
        </tr>
      </ng-template>
      <ng-template pTemplate="emptymessage">
        <tr><td [attr.colspan]="esSuperAdminSinCondominio ? 13 : 12" class="hoose-empty">Sin registros.</td></tr>
      </ng-template>
    </p-table>
  </div>
</div>


<!-- Diálogo de inserción y edición -->
<p-dialog
	[(visible)]="mostrarDialogoEdicionUnidad"
	[breakpoints]="{ '991px': '80vw', '640px': '96vw' }"
	[style]="{ width: '50vw' }"
	[modal]="true"
	[closable]="false"
	header="{{ Unidad && Unidad.id_unidad == 0 ? 'Nueva Unidad' : 'Editar Unidad' }}"
	styleClass="hoose-dialogo"
>
	<ng-template pTemplate="content">
						<form id="frmUnidad" class="mt-1" [formGroup]="frmUnidad" autocomplete="off">
			<!-- Contenedor: Condominio -->
			<div class="hoose-section" *ngIf="esSuperAdminSinCondominio">
				<div class="hoose-section-title">Condominio</div>
				<div class="row">
					<div class="col-12 col-md-6">
						<label>Condominio <span class="text-danger">*</span></label>
						<select class="form-control" formControlName="fk_id_condominio" (change)="onCondominioChangeUnidad($event)">
							<option [value]="null" disabled>Selecciona el condominio</option>
							<option *ngFor="let c of condominiosLista" [value]="c.value">{{ c.label }}</option>
						</select>
					</div>
				</div>
			</div>

			<!-- Contenedor: Información General -->
			<div class="hoose-section">
				<div class="hoose-section-title">Información General</div>
				<div class="row">
					<div class="col-12 col-md-6">
						<label>Edificio / Torre <span class="text-danger">*</span></label>
						<select formControlName="id_edificio" class="form-select" autofocus>
							<option [value]="0" disabled>Selecciona...</option>
							<option *ngFor="let e of Edificios" [value]="e.id_edificio">{{ e.tipo || 'Edificio' }}: {{ e.edificio }}</option>
						</select>
					</div>
					<div class="col-12 col-md-3">
						<label>Nivel / Piso</label>
						<input pInputText type="number" formControlName="nivel" class="w-100" min="0" />
					</div>
					<div class="col-12 col-md-3">
						<label>Número interior</label>
						<input pInputText type="text" formControlName="numero_interior" class="w-100" (input)="onGenerarNombreUnidad()" />
					</div>
				</div>
				<div class="row mt-2">
					<div class="col-12 col-md-4">
						<label>Tipo de Unidad</label>
						<select class="form-select" formControlName="tipo_unidad" (change)="onGenerarNombreUnidad()">
							<option *ngFor="let t of tiposUnidad" [value]="t">{{ t }}</option>
						</select>
					</div>
					<div class="col-12 col-md-8">
						<label>Nombre de la Unidad <span class="text-danger">*</span></label>
						<input pInputText type="text" formControlName="unidad" class="uppercase w-100" (focus)="hlpApp.selectAllContent($event)" />
					</div>
				</div>
			</div>

			<!-- Contenedor: Información Adicional -->
			<div class="hoose-section">
				<div class="hoose-section-title">Información Adicional</div>
				<div class="row">
					<div class="col-12 col-md-4">
						<label>% Indiviso</label>
						<div class="p-inputgroup"><input pInputText type="number" formControlName="porcentaje_indiviso" class="w-100" min="0" max="100" step="0.01" /><span class="p-inputgroup-addon">%</span></div>
					</div>
					<div class="col-12 col-md-4">
						<label>M²</label>
						<div class="p-inputgroup"><input pInputText type="number" formControlName="metros_cuadrados" class="w-100" min="0" step="0.01" /><span class="p-inputgroup-addon">m²</span></div>
					</div>
					<div class="col-12 col-md-4">
						<label>Cuota Mtto. Ordinaria</label>
						<div class="p-inputgroup"><span class="p-inputgroup-addon">$</span><input pInputText type="number" formControlName="cuota_mantenimiento" class="w-100" min="0" step="0.01" /></div>
					</div>
				</div>
				<div class="row mt-2">
					<div class="col-12 col-md-6">
						<label>Estacionamiento(s)</label>
						<input pInputText type="text" formControlName="estacionamiento" class="w-100" placeholder="Ej: E-15, E-16" />
					</div>
					<div class="col-12 col-md-6">
						<label>Bodega</label>
						<input pInputText type="text" formControlName="bodega" class="w-100" placeholder="Ej: B-03" />
					</div>
				</div>
			</div>

			<!-- Contenedor: Legal -->
			<div class="hoose-section">
				<div class="hoose-section-title">Legal</div>
				<div class="row">
					<div class="col-12 col-md-6">
						<label>Escrituras (PDF)</label>
						<div *ngIf="srcEscrituras" class="text-center mb-2">
							
						</div>
						<input type="file" class="form-control form-control-sm" accept=".pdf" (change)="onEscriturasSeleccionadas($event)" />
<small *ngIf="Unidad?.escrituras_archivo" class="text-muted d-block mt-1"><i class="pi pi-check-circle me-1" style="color:#10b981"></i>Archivo cargado: {{ Unidad.escrituras_archivo }}</small>
					</div>
					<div class="col-12 col-md-6">
						<label>Plano de Distribución</label>
						<input type="file" class="form-control form-control-sm" accept=".pdf,.png,.jpg,.jpeg" (change)="onPlanoSeleccionado($event)" />
<small *ngIf="Unidad?.plano_archivo" class="text-muted d-block mt-1"><i class="pi pi-check-circle me-1" style="color:#10b981"></i>Archivo cargado: {{ Unidad.plano_archivo }}</small>
					</div>
				</div>
			</div>
		</form>
	</ng-template>
	<ng-template pTemplate="footer">
		<!-- Botón Guardar -->
		<button
			pButton
			type="button"
			label="Guardar"
			icon="pi pi-save"
			class="p-button-raised p-button-info me-sm-1"
			pTooltip="Almacenar la información"
			tooltipPosition="top"
			[disabled]="!frmUnidad.valid"
			(click)="onUnidadGuardar()"
		></button>
		<!-- Botón Cancelar -->
		<button
			pButton
			type="button"
			label="Cancelar"
			icon="pi pi-times"
			class="p-button-raised p-button-warning ml-2"
			pTooltip="Cancelar el proceso"
			tooltipPosition="top"
			(click)="onUnidadCancelar()"
		></button>
	</ng-template>
</p-dialog>

<!-- Diálogo Escrituras -->
<p-dialog
	styleClass="hoose-dialogo"
	[breakpoints]="{ '991px': '80vw', '640px': '96vw' }"
	[style]="{ width: '75vw' }"
	[(visible)]="mostrarDialogoEscriturasUnidad"
	[contentStyle]="{ display: 'flex', height: '90vh' }"
	modal="true"
	header="Escrituras de la Unidad"
>
	<ng-template pTemplate="content">
		<div class="imagenPreviewContainer">
			<iframe id="fraEscrituras" class="img-thumbnail" [src]="escriturasURL()" (load)="onUnidadEscriturasMostradas()">
			</iframe>
		</div>
	</ng-template>
</p-dialog>

<!-- Diálogo Detalles de la Unidad -->
<p-dialog
  styleClass="hoose-detalle-dialog"
  [breakpoints]="{ '991px': '90vw', '640px': '98vw' }"
  [style]="{ width: '70vw', maxWidth: '900px' }"
  *ngIf="mostrarDialogoDetallesUnidad" [(visible)]="mostrarDialogoDetallesUnidad"
  [modal]="true"
  [showHeader]="false"
  [contentStyle]="{'padding': '0', 'background': '#12121f', 'border-radius': '16px'}"
>
<ng-template pTemplate="content">
<div class="hoose-detalle">
  <div class="hoose-detalle-header">
    <div class="d-flex align-items-center">
      <div class="hoose-detalle-icon-header" style="background:rgba(59,130,246,0.15)"><i class="pi pi-home" style="color:#3b82f6"></i></div>
      <div class="ms-3">
        <h4 class="mb-0 text-white">{{ UnidadDetalle?.unidad }}</h4>
        <small class="text-muted">{{ UnidadDetalle?.tipo_unidad || 'Departamento' }} — {{ UnidadDetalle?.edificio }}</small>
      </div>
    </div>
    <div class="d-flex align-items-center gap-2">
      <button pButton type="button" icon="pi pi-pencil" label="Editar" class="p-button-outlined p-button-sm" style="color:#ccc;border-color:#444" (click)="mostrarDialogoDetallesUnidad=false; onUnidadEditar(UnidadDetalle)"></button>
      <button pButton type="button" icon="pi pi-times" class="p-button-text p-button-sm" style="color:#888" (click)="mostrarDialogoDetallesUnidad=false"></button>
    </div>
  </div>

  <div class="row g-3 p-3">
    <div class="col-12 col-md-4">
      <div class="hoose-detalle-card text-center p-4">
        <div class="mx-auto mb-3" style="width:110px;height:110px;border-radius:50%;border:3px solid #3b82f6;display:flex;align-items:center;justify-content:center;background:rgba(59,130,246,0.08)">
          <i class="pi pi-home" style="color:#3b82f6;font-size:3rem"></i>
        </div>
        <div class="mb-2">
          <div style="cursor:pointer" (click)="onUnidadAlternarEstatus(UnidadDetalle)" pTooltip="{{ UnidadDetalle?.estatus == 1 ? 'Deshabilitar' : 'Habilitar' }} unidad" tooltipPosition="top">
          <span class="hoose-badge-activo" *ngIf="UnidadDetalle?.estatus == 1"><span class="hoose-dot-green"></span> Activo</span>
          <span class="hoose-badge-inactivo" *ngIf="UnidadDetalle?.estatus != 1"><span class="hoose-dot-red"></span> Inactivo</span>
          </div>
        </div>
        <h5 class="text-white mb-1">{{ UnidadDetalle?.unidad }}</h5>
        <small class="text-muted">{{ UnidadDetalle?.tipo_unidad || 'Departamento' }}</small>
      </div>
    </div>

    <div class="col-12 col-md-8">
      <!-- Info general -->
      <div class="hoose-detalle-card p-3 mb-3">
        <div class="d-flex flex-wrap gap-3">
          <div class="d-flex align-items-center gap-2">
            <div class="hoose-info-icon" style="background:rgba(233,30,138,0.15)"><i class="pi pi-building" style="color:#e91e8a"></i></div>
            <div><small class="text-muted d-block">Condominio</small><strong class="text-white">{{ UnidadDetalle?.condominio_nombre || '-' }}</strong></div>
          </div>
          <div class="d-flex align-items-center gap-2">
            <div class="hoose-info-icon" style="background:rgba(245,158,11,0.15)"><i class="pi pi-building" style="color:#f59e0b"></i></div>
            <div><small class="text-muted d-block">Edificio / Torre</small><strong class="text-white">{{ UnidadDetalle?.edificio || '-' }}</strong></div>
          </div>
          <div class="d-flex align-items-center gap-2">
            <div class="hoose-info-icon" style="background:rgba(139,92,246,0.15)"><i class="pi pi-sort-amount-up" style="color:#8b5cf6"></i></div>
            <div><small class="text-muted d-block">Nivel</small><strong class="text-white">{{ UnidadDetalle?.nivel || '-' }}</strong></div>
          </div>
          <div class="d-flex align-items-center gap-2">
            <div class="hoose-info-icon" style="background:rgba(6,182,212,0.15)"><i class="pi pi-tag" style="color:#06b6d4"></i></div>
            <div><small class="text-muted d-block">Modo</small><strong class="text-white">{{ UnidadDetalle?.modo || 'Vivienda' }}</strong></div>
          </div>
        </div>
      </div>

      <!-- Información Adicional -->
      <div class="hoose-detalle-card p-3 mb-3" *ngIf="UnidadDetalle?.porcentaje_indiviso || UnidadDetalle?.metros_cuadrados || UnidadDetalle?.cuota_mantenimiento || UnidadDetalle?.estacionamiento || UnidadDetalle?.bodega">
        <div class="d-flex align-items-center gap-2 mb-2"><div class="hoose-info-icon-sm" style="background:rgba(245,158,11,0.15)"><i class="pi pi-list" style="color:#f59e0b"></i></div><h6 class="text-white mb-0">Información Adicional</h6></div>
        <div class="row">
          <div class="col-4 mb-2" *ngIf="UnidadDetalle?.porcentaje_indiviso"><small class="text-muted d-block">% Indiviso</small><span class="text-white">{{ UnidadDetalle.porcentaje_indiviso }}%</span></div>
          <div class="col-4 mb-2" *ngIf="UnidadDetalle?.metros_cuadrados"><small class="text-muted d-block">Superficie</small><span class="text-white">{{ UnidadDetalle.metros_cuadrados }} m²</span></div>
          <div class="col-4 mb-2" *ngIf="UnidadDetalle?.cuota_mantenimiento"><small class="text-muted d-block">Cuota Mtto.</small><span class="text-white">$ {{ UnidadDetalle.cuota_mantenimiento | number:'1.2-2' }}</span></div>
          <div class="col-4 mb-2" *ngIf="UnidadDetalle?.estacionamiento"><small class="text-muted d-block">Estacionamiento</small><span class="text-white">{{ UnidadDetalle.estacionamiento }}</span></div>
          <div class="col-4 mb-2" *ngIf="UnidadDetalle?.bodega"><small class="text-muted d-block">Bodega</small><span class="text-white">{{ UnidadDetalle.bodega }}</span></div>
        </div>
      </div>

      <!-- Propietario -->
      <div class="hoose-detalle-card p-3 mb-3">
        <div class="d-flex align-items-center gap-2 mb-2"><div class="hoose-info-icon-sm" style="background:rgba(139,92,246,0.15)"><i class="pi pi-user" style="color:#8b5cf6"></i></div><h6 class="text-white mb-0">Propietario</h6></div>
        <span class="text-white" style="font-size:1rem">{{ UnidadDetalle?.propietario_nombre || 'Sin asignar' }}</span>
      </div>

      <!-- Condómino -->
      <div class="hoose-detalle-card p-3 mb-3" *ngIf="UnidadDetalle?.condomino_nombre">
        <div class="d-flex align-items-center gap-2 mb-2"><div class="hoose-info-icon-sm" style="background:rgba(16,185,129,0.15)"><i class="pi pi-users" style="color:#10b981"></i></div><h6 class="text-white mb-0">Condómino</h6></div>
        <span class="text-white" style="font-size:1rem">{{ UnidadDetalle?.condomino_nombre }}</span>
      </div>

      <!-- Legal -->
      <div class="hoose-detalle-card p-3" *ngIf="UnidadDetalle?.escrituras_archivo || UnidadDetalle?.plano_archivo">
        <div class="d-flex align-items-center gap-2 mb-2"><div class="hoose-info-icon-sm" style="background:rgba(239,68,68,0.15)"><i class="pi pi-file" style="color:#ef4444"></i></div><h6 class="text-white mb-0">Documentos Legales</h6></div>
        <div class="d-flex gap-3">
          <a *ngIf="UnidadDetalle?.escrituras_archivo" style="color:#3b82f6;text-decoration:none;cursor:pointer;font-size:0.85rem" (click)="onUnidadEscriturasMostrar(UnidadDetalle)"><i class="pi pi-file-pdf me-1"></i>Escrituras</a>
          <a *ngIf="UnidadDetalle?.plano_archivo" style="color:#3b82f6;text-decoration:none;cursor:pointer;font-size:0.85rem" (click)="onUnidadPlanoMostrar(UnidadDetalle)"><i class="pi pi-image me-1"></i>Plano de Distribución</a>
        </div>
      </div>
    </div>
  </div>
</div>
</ng-template>
</p-dialog>
