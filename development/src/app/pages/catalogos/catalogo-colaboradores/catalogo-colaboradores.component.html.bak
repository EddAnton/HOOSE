<div class="hoose-tabla-wrapper" style="margin: 16px 16px 0 0;">
  <div class="hoose-tabla-toolbar" style="align-items:flex-start;gap:16px;flex-wrap:nowrap">
    <div style="flex-shrink:0;max-width:70%">
    <div class="hoose-kpi-card hoose-kpi-pink" style="margin:0">
      <div class="hoose-kpi-icon"><i class="pi pi-briefcase"></i></div>
      <div class="hoose-kpi-body">
        <span class="hoose-kpi-label">Total Colaboradores</span>
        <span class="hoose-kpi-value">{{ ColaboradoresFiltrados.length }}</span>
        <span class="hoose-kpi-sub">Activos: <b>{{ kpiActivos }}</b> &nbsp;|&nbsp; Inactivos: <b>{{ kpiInactivos }}</b></span>
      </div>
    </div>
    </div>
    <div class="d-flex flex-column gap-2 justify-content-between">
      <div class="d-flex justify-content-end">
        <button *ngIf="permitirAgregarEditar" pButton type="button" icon="pi pi-plus" label="Nuevo Colaborador" class="hoose-btn-nuevo" tooltipPosition="left" (click)="onColaboradorEditar()"></button>
      </div>
      <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
        <div class="hoose-tabla-search">
          <i class="pi pi-search"></i>
          <input type="text" placeholder="Buscar colaborador..." (input)="ptColaboradores.filterGlobal($event.target.value, 'contains')" />
        </div>
        <select *ngIf="esSuperAdminSinCondominio" class="hoose-filtro-select" [(ngModel)]="filtroCondominio">
          <option [ngValue]="null">Condominio</option>
          <option *ngFor="let c of condominiosLista" [ngValue]="c.value">{{ c.label }}</option>
        </select>
        <select class="hoose-filtro-select" [(ngModel)]="filtroEstatus">
          <option [ngValue]="null">Estatus</option>
          <option [ngValue]="1">Activo</option>
          <option [ngValue]="0">Inactivo</option>
        </select>
        <button pButton type="button" icon="pi pi-times" class="hoose-btn-clear" pTooltip="Limpiar filtros" tooltipPosition="left" (click)="limpiarFiltros(); hlpPrimeNGTable.reset(ptColaboradores)"></button>
      </div>
    </div>
  </div>
  <div class="hoose-tabla-container" style="overflow-x:auto">
    <p-table #ptColaboradores [value]="ColaboradoresFiltrados" [globalFilterFields]="ColaboradoresFilter"
      [rowHover]="true" [showCurrentPageReport]="true" [paginator]="ColaboradoresFiltrados.length > 0"
      [rows]="20" dataKey="id_usuario" styleClass="hoose-table"
      currentPageReportTemplate="Mostrando {first} - {last} de {totalRecords}" [rowsPerPageOptions]="[10,20,50]">
      <ng-template pTemplate="header">
        <tr>
          <th *ngIf="esSuperAdminSinCondominio" class="hoose-th" style="min-width:140px;white-space:nowrap">Condominio</th>
          <th class="hoose-th" style="min-width:180px;white-space:nowrap">Nombre</th>
          <th class="hoose-th" style="min-width:180px;white-space:nowrap">Email</th>
          <th class="hoose-th" style="min-width:130px;white-space:nowrap">Contacto</th>
          <th class="hoose-th" style="min-width:120px;white-space:nowrap">Tipo</th>
          <th class="hoose-th text-center" style="min-width:120px;white-space:nowrap">Fecha Inicio</th>
          <th class="hoose-th text-center" style="min-width:110px;white-space:nowrap">Salario</th>
          <th class="hoose-th text-center" style="min-width:100px;white-space:nowrap">Estatus</th>
          <th class="hoose-th text-center" style="min-width:110px;white-space:nowrap">Acciones</th>
        </tr>
      </ng-template>
      <ng-template pTemplate="body" let-Colaborador>
        <tr class="hoose-tr" (click)="onColaboradorDetalles(Colaborador.id_usuario)">
          <td *ngIf="esSuperAdminSinCondominio" class="hoose-td">
            <span class="hoose-cond-pill" [ngStyle]="{'color': getCondominioColor(Colaborador.condominio_nombre), 'background': getCondominioColor(Colaborador.condominio_nombre) + '18'}">{{ Colaborador.condominio_nombre || '—' }}</span>
          </td>
          <td class="hoose-td">
            <div class="d-flex align-items-center gap-2">
              <img class="rounded-circle" src="{{ Colaborador.imagen ? appData.urlBackendUsuariosFiles + Colaborador.id_usuario + '/' + Colaborador.imagen : './assets/img/imagen_no_disponible.png' }}" style="width:32px;height:32px;object-fit:cover;flex-shrink:0" />
              <strong class="hoose-nombre">{{ Colaborador.nombre }} {{ Colaborador.apellidos || '' }}</strong>
            </div>
          </td>
          <td class="hoose-td"><span class="hoose-num">{{ Colaborador.email || '—' }}</span></td>
          <td class="hoose-td"><span class="hoose-num">{{ Colaborador.telefono | phoneFormat }}</span></td>
          <td class="hoose-td"><span class="hoose-tipo-pill">{{ Colaborador.tipo_miembro || '—' }}</span></td>
          <td class="hoose-td text-center"><span class="hoose-num">{{ Colaborador.fecha_inicio ? (Colaborador.fecha_inicio | date:'dd/MM/yyyy') : '—' }}</span></td>
          <td class="hoose-td text-center"><span class="hoose-num">{{ Colaborador.salario ? ('$' + (Colaborador.salario | number:'1.2-2')) : '—' }}</span></td>
          <td class="hoose-td text-center">
            <span class="hoose-estatus-pill {{ Colaborador.estatus == 1 ? 'activo' : 'inactivo' }}" style="cursor:pointer"
              (click)="$event.stopPropagation(); permitirAgregarEditar && onColaboradorAlternarEstatus(Colaborador)"
              pTooltip="{{ Colaborador.estatus == 1 ? 'Deshabilitar' : 'Habilitar' }}" tooltipPosition="top">
              <span class="hoose-estatus-dot"></span>{{ Colaborador.estatus == 1 ? 'Activo' : 'Inactivo' }}
            </span>
          </td>
          <td class="hoose-td text-center" (click)="$event.stopPropagation()">
            <button pButton type="button" icon="pi pi-eye" class="hoose-btn-accion" pTooltip="Ver detalles" tooltipPosition="top" (click)="onColaboradorDetalles(Colaborador.id_usuario)"></button>
            <button *ngIf="permitirAgregarEditar && Colaborador.estatus == 1" pButton type="button" icon="pi pi-pencil" class="hoose-btn-accion" pTooltip="Editar" tooltipPosition="top" (click)="onColaboradorEditar(Colaborador.id_usuario)"></button>
            <button *ngIf="esSuperAdmin" pButton type="button" icon="pi pi-trash" class="hoose-btn-accion" style="color:#ef4444 !important" pTooltip="Eliminar" tooltipPosition="top" (click)="$event.stopPropagation(); onColaboradorEliminar(Colaborador)"></button>
          </td>
        </tr>
      </ng-template>
      <ng-template pTemplate="emptymessage">
        <tr><td [attr.colspan]="esSuperAdminSinCondominio ? 9 : 8" class="hoose-empty">Sin registros.</td></tr>
      </ng-template>
    </p-table>
  </div>
</div>
<!-- Diálogo de inserción y edición -->
<p-dialog
	#dlgColaborador
	[(visible)]="mostrarDialogoEdicionColaborador"
	[breakpoints]="{ '991px': '80vw', '640px': '96vw' }"
	[style]="{ width: '50vw' }"
	[modal]="true"
	[closable]="false"
	header="Detalles del Colaborador {{ Colaborador && Colaborador.id_usuario == 0 ? ' Nuevo' : '' }}"
	styleClass="hoose-dialogo"
>
	<ng-template pTemplate="content">
		<form *ngIf="frmColaborador" id="frmColaborador" class="mt-1" [formGroup]="frmColaborador" autocomplete="off">
			<!-- Condominio -->
			<div class="hoose-section" *ngIf="esSuperAdminSinCondominio">
				<div class="hoose-section-title">Condominio</div>
				<div class="row">
					<div class="col-12 col-md-6">
						<label>Condominio <span class="text-danger">*</span></label>
						<select class="form-control" formControlName="fk_id_condominio">
							<option [value]="null" disabled>Selecciona el condominio</option>
							<option *ngFor="let c of condominiosLista" [value]="c.value">{{ c.label }}</option>
						</select>
					</div>
				</div>
			</div>

			<!-- Datos Generales -->
			<div class="hoose-section">
				<div class="hoose-section-title">Datos Generales</div>
				<div class="row">
					<div class="col-12 col-md-6">
						<label>Nombre(s) <span class="text-danger">*</span></label>
						<input type="text" pInputText formControlName="nombre" class="uppercase w-100" autofocus (focus)="hlpApp.selectAllContent($event)" (input)="onGenerarUsuario()" />
					</div>
					<div class="col-12 col-md-6">
						<label>Apellidos <span class="text-danger">*</span></label>
						<input type="text" pInputText formControlName="apellidos" class="uppercase w-100" (focus)="hlpApp.selectAllContent($event)" (input)="onGenerarUsuario()" />
					</div>
				</div>
				<div class="row mt-2">
					<div class="col-12 col-md-6">
						<label>Email</label>
						<input type="text" pInputText formControlName="email" class="lowercase w-100" (focus)="hlpApp.selectAllContent($event)" />
					</div>
					<div class="col-12 col-md-6">
						<label>Teléfono</label>
						<p-inputMask formControlName="telefono" mask="(9999) 99-9999" unmask="true" placeholder="(9999) 99-9999" (focus)="hlpApp.selectAllContent($event)"></p-inputMask>
					</div>
				</div>
				<div class="row mt-2">
					<div class="col-12">
						<label>Imagen de Perfil</label>
						<input type="file" class="form-control form-control-sm" accept=".png,.jpg,.jpeg" (change)="onImagenSeleccionada($event, 1)" />
						<small *ngIf="Colaborador?.imagen" class="text-muted d-block mt-1"><i class="pi pi-check-circle me-1" style="color:#10b981"></i>Archivo cargado: {{ Colaborador.imagen }}</small>
					</div>
				</div>
			</div>

			<!-- Identificación -->
			<div class="hoose-section">
				<div class="hoose-section-title">Identificación</div>
				<div class="row">
					<div class="col-12 col-md-6">
						<label>Folio Identificación <span class="text-danger">*</span></label>
						<input pInputText type="text" formControlName="identificacion_folio" class="uppercase w-100" (focus)="hlpApp.selectAllContent($event)" />
					</div>
					<div class="col-12 col-md-6">
						<label>Domicilio <span class="text-danger">*</span></label>
						<textarea pInputTextarea formControlName="identificacion_domicilio" rows="2" class="uppercase w-100" (focus)="hlpApp.selectAllContent($event)"></textarea>
					</div>
				</div>
				<div class="row mt-2">
					<div class="col-12 col-md-6">
						<label>Anverso Identificación <span class="text-danger">*</span></label>
						<input type="file" class="form-control form-control-sm" accept=".png,.jpg,.jpeg" (change)="onImagenSeleccionada($event, 2)" />
						<small *ngIf="Colaborador?.identificacion_anverso" class="text-muted d-block mt-1"><i class="pi pi-check-circle me-1" style="color:#10b981"></i>Archivo cargado: {{ Colaborador.identificacion_anverso }}</small>
					</div>
					<div class="col-12 col-md-6">
						<label>Reverso Identificación <span class="text-danger">*</span></label>
						<input type="file" class="form-control form-control-sm" accept=".png,.jpg,.jpeg" (change)="onImagenSeleccionada($event, 3)" />
						<small *ngIf="Colaborador?.identificacion_reverso" class="text-muted d-block mt-1"><i class="pi pi-check-circle me-1" style="color:#10b981"></i>Archivo cargado: {{ Colaborador.identificacion_reverso }}</small>
					</div>
				</div>
			</div>

			<!-- Cuenta de Usuario -->
			<div class="hoose-section">
				<div class="hoose-section-title">Cuenta de Usuario</div>
				<div class="row">
					<div class="col-12 col-md-6">
						<label>Usuario <span class="text-danger">*</span></label>
						<input type="text" pInputText formControlName="usuario" class="lowercase w-100" (focus)="hlpApp.selectAllContent($event)" (blur)="onVerificarUsuario()" (input)="usuarioManualmenteEditado=true" />
					</div>
				</div>
				<div class="row mt-2" *ngIf="frmColaborador.get('id_usuario').value == 0">
					<div class="col-12">
						<app-password-input [control]="frmColaborador.get('contrasenia')" label="Contraseña inicial" placeholder="Se enviará al correo" [confirmar]="true" [required]="true"></app-password-input>
					</div>
				</div>
			</div>

			<!-- Información Laboral -->
			<div class="hoose-section">
				<div class="hoose-section-title">Información Laboral</div>
				<div class="row">
					<div class="col-12 col-md-6">
						<label>Tipo de Colaborador</label>
						<select formControlName="id_tipo_miembro" class="form-select">
							<option [value]="0" disabled>Selecciona tipo...</option>
							<option *ngFor="let t of TiposMiembro" [value]="t.id_tipo_miembro">{{ t.tipo_miembro }}</option>
						</select>
					</div>
					<div class="col-12 col-md-6">
						<label>Salario Mensual</label>
						<div class="p-inputgroup"><span class="p-inputgroup-addon">$</span><p-inputNumber formControlName="salario" mode="decimal" locale="es-MX" [minFractionDigits]="2" [maxFractionDigits]="2" [step]="0" [inputStyle]="{ 'text-align': 'right' }" (onFocus)="hlpApp.selectAllContent($event)"></p-inputNumber></div>
					</div>
				</div>
				<div class="row mt-2">
					<div class="col-12 col-md-6">
						<label>Fecha de Contratación</label>
						<p-calendar [showIcon]="true" formControlName="fecha_inicio" dateFormat="dd-MM-yy" [appendTo]="dlgColaborador" [inputStyle]="{ 'text-align': 'right' }" inputStyleClass="uppercase"></p-calendar>
					</div>
					<div class="col-12 col-md-6">
						<label>Contrato Laboral</label>
						<input type="file" class="form-control form-control-sm" accept=".pdf" (change)="onContratoSeleccionado($event)" />
						<small *ngIf="Colaborador?.contrato" class="text-muted d-block mt-1"><i class="pi pi-check-circle me-1" style="color:#10b981"></i>Archivo cargado: {{ Colaborador.contrato }}</small>
					</div>
				</div>
			</div>
		</form>
	</ng-template>
	<ng-template pTemplate="footer">
		<!-- Botón Guardar -->
		<button
			pButton
			type="button"
			label="Guardar"
			icon="pi pi-save"
			class="p-button-raised p-button-info me-sm-1"
			pTooltip="Almacenar la información"
			tooltipPosition="top"
			[disabled]="!frmColaborador.valid"
			(click)="onColaboradorGuardar()"
		></button>
<button pButton type="button" icon="pi pi-key" label="Restablecer contraseña" class="p-button-outlined p-button-warning me-2" *ngIf="Colaborador.id_usuario > 0" (click)="onAbrirResetContrasenia(Colaborador.id_usuario)"></button>
<button pButton type="button" label="Cancelar" icon="pi pi-times" class="p-button-raised p-button-warning ml-2" (click)="onColaboradorCancelar()"></button>
	</ng-template>
</p-dialog>

<!-- Diálogo Restablecer Contraseña -->
<p-dialog [(visible)]="mostrarDialogoResetContrasenia" [modal]="true" [dismissableMask]="true"
  [style]="{ width: '380px' }" header="Restablecer contraseña" styleClass="p-fluid">
  <ng-template pTemplate="content">
    <div class="mb-3"><p>Nueva contraseña para el usuario:</p>
    <div class="d-flex gap-2">
      <input pInputText [(ngModel)]="nuevaContraseniaReset" [ngModelOptions]="{standalone:true}" class="w-100" placeholder="Nueva contraseña" />
      <button pButton type="button" icon="pi pi-refresh" pTooltip="Sugerir" (click)="nuevaContraseniaReset = generarContrasenaSugerida()"></button>
    </div></div>
  </ng-template>
  <ng-template pTemplate="footer">
    <button pButton type="button" label="Cancelar" icon="pi pi-times" class="p-button-warning me-2" (click)="mostrarDialogoResetContrasenia=false"></button>
    <button pButton type="button" label="Guardar contraseña" icon="pi pi-check" class="p-button-success" (click)="onGuardarResetContrasenia()"></button>
  </ng-template>
</p-dialog>

<!-- Diálogo Imagen del Colaborador -->
<p-dialog
	styleClass="hoose-dialogo"
	[breakpoints]="{ '991px': '80vw', '640px': '96vw' }"
	[style]="{ width: '75vw' }"
	[(visible)]="mostrarDialogoImagenColaborador"
	[contentStyle]="{ display: 'flex' }"
	modal="true"
	header="Imagen del Colaborador"
	baseZIndex="99"
>
	<ng-template pTemplate="content">
		<div class="imagenPreviewContainer imagenPreview">
			<img [src]="srcImagenMostrar" />
		</div>
	</ng-template>
</p-dialog>

<!-- Diálogo Contrato -->
<p-dialog
	styleClass="hoose-dialogo"
	[breakpoints]="{ '991px': '80vw', '640px': '96vw' }"
	[style]="{ width: '75vw' }"
	[(visible)]="mostrarDialogoContratoColaborador"
	[contentStyle]="{ display: 'flex', height: '90vh' }"
	modal="true"
	header="Contrato de arrendamiento del Condómino"
>
	<ng-template pTemplate="content">
		<div class="imagenPreviewContainer">
			<iframe id="fraContrato" class="img-thumbnail" [src]="contratoURL()" (load)="onContratoMostrado()"> </iframe>
		</div>
	</ng-template>
</p-dialog>

<!-- Diálogo Detalles del Colaborador -->
<p-dialog
  styleClass="hoose-detalle-dialog"
  [breakpoints]="{ '991px': '90vw', '640px': '98vw' }"
  [style]="{ width: '70vw', maxWidth: '900px' }"
  *ngIf="mostrarDialogoDetallesColaborador" [(visible)]="mostrarDialogoDetallesColaborador"
  [modal]="true"
  [showHeader]="false"
  [contentStyle]="{'padding': '0', 'background': '#12121f', 'border-radius': '16px'}"
>
<ng-template pTemplate="content">
<div class="hoose-detalle">
  <div class="hoose-detalle-header">
    <div class="d-flex align-items-center">
      <div class="hoose-detalle-icon-header" style="background:rgba(6,182,212,0.15)"><i class="pi pi-briefcase" style="color:#06b6d4"></i></div>
      <div class="ms-3">
        <h4 class="mb-0 text-white">Detalles del Colaborador</h4>
        <small class="text-muted">{{ Colaborador.tipo_miembro || 'Colaborador' }} — {{ Colaborador.condominio_nombre || 'Sin condominio' }}</small>
      </div>
    </div>
    <div class="d-flex align-items-center gap-2">
      <button pButton type="button" icon="pi pi-pencil" label="Editar" class="p-button-outlined p-button-sm" style="color:#ccc;border-color:#444" (click)="mostrarDialogoDetallesColaborador=false; onColaboradorEditar(Colaborador.id_usuario)"></button>
      <button pButton type="button" icon="pi pi-times" class="p-button-text p-button-sm" style="color:#888" (click)="mostrarDialogoDetallesColaborador=false"></button>
    </div>
  </div>

  <div class="row g-3 p-3">
    <div class="col-12 col-md-4">
      <div class="hoose-detalle-card text-center p-4">
        <div class="hoose-avatar-ring mx-auto mb-3" style="border-color:#06b6d4" (click)="srcImagen && onImagenMostrar(srcImagen)" [ngStyle]="{'cursor': srcImagen ? 'pointer' : 'default'}">
          <img *ngIf="srcImagen" [src]="srcImagen" class="hoose-avatar-img" />
          <span *ngIf="!srcImagen" class="hoose-avatar-initials" style="color:#06b6d4">{{ (Colaborador.nombre || 'C').charAt(0) }}</span>
        </div>
        <div class="mb-2">
          <div style="cursor:pointer" (click)="onColaboradorAlternarEstatus(Colaborador)" pTooltip="{{ Colaborador?.estatus == 1 ? 'Deshabilitar' : 'Habilitar' }} colaborador" tooltipPosition="top">
          <span class="hoose-badge-activo" *ngIf="Colaborador.estatus == 1"><span class="hoose-dot-green"></span> Activo</span>
          <span class="hoose-badge-inactivo" *ngIf="Colaborador.estatus != 1"><span class="hoose-dot-red"></span> Inactivo</span>
          </div>
        </div>
        <h5 class="text-white mb-1">{{ Colaborador.nombre }} {{ Colaborador.apellidos || '' }}</h5>
        <small class="text-muted">{{ Colaborador.usuario }}</small>

        <div class="d-flex flex-column gap-2 mt-3">
          <div class="hoose-stat-box w-100 text-center py-2">
            <i class="pi pi-briefcase" style="color:#06b6d4;font-size:1.1rem"></i>
            <div class="hoose-stat-val">{{ Colaborador.tipo_miembro || '-' }}</div>
            <div class="hoose-stat-label">Tipo</div>
          </div>
          <div class="hoose-stat-box w-100 text-center py-2">
            <i class="pi pi-dollar" style="color:#10b981;font-size:1.1rem"></i>
            <div class="hoose-stat-val">{{ Colaborador.salario ? ('$' + (Colaborador.salario | number:'1.2-2')) : '-' }}</div>
            <div class="hoose-stat-label">Salario</div>
          </div>
          <div class="hoose-stat-box w-100 text-center py-2">
            <i class="pi pi-calendar" style="color:#f59e0b;font-size:1.1rem"></i>
            <div class="hoose-stat-val">{{ Colaborador.fecha_inicio ? (Colaborador.fecha_inicio | date:'dd/MM/yyyy') : '-' }}</div>
            <div class="hoose-stat-label">Fecha Inicio</div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-md-8">
      <!-- Quick info -->
      <div class="hoose-detalle-card p-3 mb-3">
        <div class="d-flex flex-wrap gap-3">
          <div class="d-flex align-items-center gap-2" *ngIf="Colaborador.condominio_nombre">
            <div class="hoose-info-icon" style="background:rgba(233,30,138,0.15)"><i class="pi pi-building" style="color:#e91e8a"></i></div>
            <div><small class="text-muted d-block">Condominio</small><strong class="text-white">{{ Colaborador.condominio_nombre }}</strong></div>
          </div>
          <div class="d-flex align-items-center gap-2" *ngIf="Colaborador.email">
            <div class="hoose-info-icon" style="background:rgba(59,130,246,0.15)"><i class="pi pi-envelope" style="color:#3b82f6"></i></div>
            <div><small class="text-muted d-block">Email</small><a [href]="'mailto:' + Colaborador.email" style="color:#3b82f6;font-size:0.85rem;font-weight:600;text-decoration:none">{{ Colaborador.email }}</a></div>
          </div>
          <div class="d-flex align-items-center gap-2" *ngIf="Colaborador.telefono">
            <div class="hoose-info-icon" style="background:rgba(16,185,129,0.15)"><i class="pi pi-phone" style="color:#10b981"></i></div>
            <div><small class="text-muted d-block">Teléfono</small><a [href]="'tel:' + Colaborador.telefono" style="color:#10b981;font-weight:600;text-decoration:none">{{ Colaborador.telefono | phoneFormat }}</a></div>
          </div>
        </div>
      </div>

      <!-- Domicilio -->
      <div class="hoose-detalle-card p-3 mb-3" *ngIf="Colaborador.domicilio">
        <div class="d-flex align-items-center gap-2 mb-2"><div class="hoose-info-icon-sm" style="background:rgba(16,185,129,0.15)"><i class="pi pi-map-marker" style="color:#10b981"></i></div><h6 class="text-white mb-0">Domicilio</h6></div>
        <span class="text-white">{{ Colaborador.domicilio }}</span>
      </div>

      <!-- Identificación -->
      <div class="hoose-detalle-card p-3 mb-3">
        <div class="d-flex align-items-center gap-2 mb-2"><div class="hoose-info-icon-sm" style="background:rgba(59,130,246,0.15)"><i class="pi pi-id-card" style="color:#3b82f6"></i></div><h6 class="text-white mb-0">Identificación</h6></div>
        <div class="row">
          <div class="col-6"><small class="text-muted d-block">Folio</small><span class="text-white">{{ Colaborador.identificacion_folio || 'No registrado' }}</span></div>
          <div class="col-6"><small class="text-muted d-block">Domicilio Identificación</small><span class="text-white">{{ Colaborador.identificacion_domicilio || 'No registrado' }}</span></div>
        </div>
        <div class="row mt-2" *ngIf="srcIdentificacionAnverso || srcIdentificacionReverso">
          <div class="col-6 text-center" *ngIf="srcIdentificacionAnverso">
            <small class="text-muted d-block mb-1">Anverso</small>
            <img [src]="srcIdentificacionAnverso" class="img-fluid rounded" style="max-height:120px;cursor:pointer;border:1px solid #333" (click)="onImagenMostrar(srcIdentificacionAnverso)" />
          </div>
          <div class="col-6 text-center" *ngIf="srcIdentificacionReverso">
            <small class="text-muted d-block mb-1">Reverso</small>
            <img [src]="srcIdentificacionReverso" class="img-fluid rounded" style="max-height:120px;cursor:pointer;border:1px solid #333" (click)="onImagenMostrar(srcIdentificacionReverso)" />
          </div>
        </div>
      </div>

      <!-- Contrato -->
      <div class="hoose-detalle-card p-3" *ngIf="Colaborador.contrato">
        <div class="d-flex align-items-center gap-2 mb-2"><div class="hoose-info-icon-sm" style="background:rgba(239,68,68,0.15)"><i class="pi pi-file-pdf" style="color:#ef4444"></i></div><h6 class="text-white mb-0">Contrato</h6></div>
        <a [href]="'http://api.residenciales.hoose.mx/uploads/usuarios/' + Colaborador.id_usuario + '/' + Colaborador.contrato" target="_blank" class="d-flex align-items-center gap-2" style="color:#ef4444;text-decoration:none;font-size:0.9rem"><i class="pi pi-file-pdf"></i><span>Contrato Laboral</span><i class="pi pi-external-link ms-1" style="font-size:0.75rem"></i></a>
      </div>
    </div>
  </div>
</div>
</ng-template>
</p-dialog>
