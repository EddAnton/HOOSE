<div class="cond-wrapper">
  <!-- ── Toolbar ── -->
  <div class="hoose-tabla-toolbar" style="display:flex;align-items:center;gap:16px;background:transparent;border:none;padding:16px 16px 0 16px">
    <div class="hoose-kpi-card hoose-kpi-blue" style="margin:0;flex-shrink:0">
      <div class="hoose-kpi-icon"><i class="pi pi-building"></i></div>
      <div class="hoose-kpi-body">
        <span class="hoose-kpi-label">Total Inmuebles</span>
        <span class="hoose-kpi-value">{{ Cards.length }}</span>
        <span class="hoose-kpi-sub">Activos: <b>{{ kpiCardsActivos }}</b></span>
      </div>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end" style="margin-left:auto">
      <div class="als-vista-switcher als-switcher-center">
        <button [class.active]="vistaActual === 'cards'" (click)="cambiarVista('cards')">
          <i class="pi pi-th-large"></i> Cards
        </button>
        <button [class.active]="vistaActual === 'carrusel'" (click)="cambiarVista('carrusel')">
          <i class="pi pi-images"></i> Carrusel
        </button>
      </div>
      <div class="hoose-tabla-search" style="border:1.5px solid #2d3150!important;box-shadow:none!important;min-width:220px">
        <i class="pi pi-search"></i>
        <input type="text" placeholder="Buscar inmueble..." [(ngModel)]="filtroCardBusqueda" (ngModelChange)="filtrarCards()" />
      </div>
      <div class="als-filtros-group">
        <select class="hoose-filtro-select" [(ngModel)]="filtroCardEstatus" (ngModelChange)="filtrarCards()">
          <option [ngValue]="null">Estatus</option>
          <option [ngValue]="1">Activo</option>
          <option [ngValue]="0">Inactivo</option>
        </select>
        <select class="hoose-filtro-select" [(ngModel)]="filtroCardTipo" (ngModelChange)="filtrarCards()">
          <option [ngValue]="null">Tipo</option>
          <option *ngFor="let t of tiposCondominio" [ngValue]="t.value">{{ t.label }}</option>
        </select>
        <button pButton type="button" icon="pi pi-times" class="hoose-btn-clear"
          pTooltip="Limpiar filtros" tooltipPosition="left"
          style="background:#e2e8f0!important;border-color:#e2e8f0!important;color:#64748b!important;flex-shrink:0"
          (click)="limpiarFiltrosCards()">
        </button>
      </div>
    </div>

  </div>

  <!-- ── Vista Cards ── -->
  <div *ngIf="vistaActual === 'cards'" style="padding:16px">

    <!-- FAB flotante agregar -->
    <button pButton type="button" icon="pi pi-plus" class="p-button-rounded p-button-raised hoose-fab" pTooltip="Nuevo inmueble" tooltipPosition="left" (click)="onCondominioEditar()"></button>
    <div *ngIf="cargandoCards" class="text-center p-5">
      <i class="pi pi-spin pi-spinner" style="font-size:2rem;color:#e91e8c"></i>
      <p class="text-muted mt-2">Cargando inmuebles...</p>
    </div>
    <div *ngIf="!cargandoCards" class="row g-3">
      <div *ngFor="let card of CardsFiltradas" class="col-12 col-sm-6 col-lg-4 col-xl-3">
        <div class="als-inmueble-card" (click)="onVerDetalleCard(card)">
          <div class="als-card-body">
            <div class="als-card-top">
              <img [src]="getImagenCard(card)" [alt]="card.condominio" class="als-card-avatar" />
              <div class="als-card-title-wrap">
                <span class="als-card-tipo-pill">{{ card.tipo || 'INMUEBLE' }}</span>
                <h5 class="als-card-title">{{ card.condominio }}</h5>
                <p class="als-card-dir" *ngIf="card.domicilio">
                  <i class="pi pi-map-marker"></i> {{ card.domicilio }}
                </p>
              </div>
              <div class="als-card-actions">
                <span class="als-estatus-badge" [class.verde]="card.estatus == 1" [class.rojo]="card.estatus != 1">
                  <span class="als-estatus-dot" [class.verde]="card.estatus == 1" [class.rojo]="card.estatus != 1"></span>
                  {{ card.estatus == 1 ? 'Activo' : 'Inactivo' }}
                </span>
                <i class="pi pi-pencil als-edit-icon"
                  (click)="$event.stopPropagation(); onCondominioEditar(card.id_condominio)"
                  pTooltip="Editar" tooltipPosition="top"></i>
              </div>
            </div>
            <div class="als-card-stats-2">
              <div class="als-stat-half">
                <span class="als-stat-num">{{ card.edificios }}</span>
                <span class="als-stat-lbl">Edificios / Torres</span>
              </div>
              <div class="als-stat-half">
                <span class="als-stat-num">{{ card.unidades }}</span>
                <span class="als-stat-lbl">Unidades</span>
              </div>
            </div>
            <hr class="als-card-divider" />
            <div class="als-card-financiero">
              <div class="als-fin-item">
                <span class="als-fin-lbl">Recaudación</span>
                <span class="als-fin-val" [style.color]="card.recaudacion < 0 ? '#ef4444' : '#10b981'">
                  {{ card.recaudacion | currency:'MXN':'symbol':'1.0-0' }}
                </span>
              </div>
              <div class="als-fin-item">
                <span class="als-fin-lbl">Morosidad</span>
                <span class="als-fin-val" [style.color]="card.morosidad >= 20 ? '#ef4444' : card.morosidad >= 10 ? '#f59e0b' : '#10b981'">
                  {{ card.morosidad | number:'1.1-1' }}%
                </span>
              </div>
              <div class="als-fin-item">
                <span class="als-fin-lbl">Ocupación</span>
                <span class="als-fin-val" [style.color]="card.ocupacion < 50 ? '#ef4444' : card.ocupacion < 70 ? '#f59e0b' : '#10b981'">
                  {{ card.ocupacion | number:'1.1-1' }}%
                </span>
              </div>
            </div>
            <div class="als-card-admin" *ngIf="card.administrador">
              <i class="pi pi-user"></i>
              <span>{{ card.administrador.nombre }} {{ card.administrador.apellidos }}</span>
            </div>
            <div class="als-card-admin als-card-admin-empty" *ngIf="!card.administrador">
              <i class="pi pi-user"></i>
              <span>Sin administrador</span>
            </div>
          </div>
        </div>
      </div>
      <div *ngIf="CardsFiltradas.length === 0" class="col-12 text-center p-5">
        <i class="pi pi-inbox" style="font-size:3rem;color:#d1dbe8"></i>
        <p class="text-muted mt-2">No hay inmuebles que coincidan con los filtros</p>
      </div>
    </div>
  </div>

  <!-- ── Vista Carrusel ── -->
  <div *ngIf="vistaActual === 'carrusel'">

  <!-- FAB flotante agregar -->
  <button pButton type="button" icon="pi pi-plus" class="p-button-rounded p-button-raised hoose-fab" pTooltip="Nuevo inmueble" tooltipPosition="left" (click)="onCondominioEditar()"></button>

  <!-- RUEDA 3D -->
  <div class="cond-rueda-wrap" *ngIf="Condominios.length > 0">
    <button class="cond-arrow cond-arrow-left" (click)="onAnterior()">
      <i class="pi pi-chevron-left"></i>
    </button>

    <div class="cond-rueda">
      <div class="cond-rueda-item"
        *ngFor="let c of Condominios; let i = index"
        [ngStyle]="getItemStyle(i)"
        (click)="onSeleccionarCondominio(i)">
        <img [src]="getImagenUrl(c)" [alt]="c.condominio" [ngStyle]="getImgStyle(i)"/>
        <div class="cond-rueda-label" *ngIf="isVisible(i) && i !== idxSeleccionado">
          <span class="cond-item-tipo">{{ c.tipo || 'CONDOMINIO' }}</span>
          <span class="cond-item-nombre">{{ c.condominio }}</span>
        </div>
      </div>
    </div>

    <button class="cond-arrow cond-arrow-right" (click)="onSiguiente()">
      <i class="pi pi-chevron-right"></i>
    </button>

    <!-- Estatus + dots -->
    <div class="cond-rueda-footer">
      <span class="cond-item-tipo" style="text-align:center">{{ Condominios[idxSeleccionado]?.tipo || 'CONDOMINIO' }}</span>
      <span class="cond-item-nombre" style="font-size:1.6rem;font-weight:800;text-align:center">{{ Condominios[idxSeleccionado]?.condominio }}</span>
      <span class="cond-item-sub" *ngIf="Condominios[idxSeleccionado]?.domicilio" style="text-align:center">{{ Condominios[idxSeleccionado]?.domicilio }}</span>
      <span class="cond-estatus-badge"
        [ngClass]="Condominios[idxSeleccionado]?.estatus == 1 ? 'cond-estatus-active' : 'cond-estatus-inactive'"
        (click)="onCondominioAlternarEstatus(Condominios[idxSeleccionado])"
        style="cursor:pointer">
        {{ Condominios[idxSeleccionado]?.estatus == 1 ? 'Activo' : 'Inactivo' }}
      </span>
      <div class="cond-dots">
        <span *ngFor="let c of Condominios; let i = index"
          class="cond-dot" [class.cond-dot-active]="i === idxSeleccionado"
          (click)="onSeleccionarCondominio(i)">
        </span>
      </div>
    </div>
  </div>

  <!-- PANEL INFO -->
  <div class="cond-panel" *ngIf="CondominioSeleccionado">

    <!-- Panel header -->
    <div class="cond-panel-header">
      <span class="cond-panel-titulo">
        <i class="pi pi-building me-2" style="color:var(--c-pink)"></i>
        {{ CondominioSeleccionado.condominio }}
      </span>
      <button pButton type="button" icon="pi pi-pencil" label="Editar"
        class="p-button-raised p-button-sm cond-btn-editar"
        (click)="onCondominioEditar(CondominioSeleccionado.id_condominio)">
      </button>
    </div>

    <div class="cond-panel-grid">

      <!-- Columna 1: Info general -->
      <div class="cond-panel-card">
        <div class="cond-card-title"><i class="pi pi-info-circle"></i> Información General</div>
        <div class="cond-data-list">
          <div class="cond-data-item" *ngIf="CondominioSeleccionado.tipo">
            <i class="pi pi-tag cond-data-icon"></i>
            <div>
              <span class="cond-data-label">Tipo</span>
              <span class="cond-data-value">{{ CondominioSeleccionado.tipo }}</span>
            </div>
          </div>
          <div class="cond-data-item" *ngIf="CondominioSeleccionado.metros_cuadrados">
            <i class="pi pi-map cond-data-icon"></i>
            <div>
              <span class="cond-data-label">Superficie</span>
              <span class="cond-data-value">{{ CondominioSeleccionado.metros_cuadrados | number }} m²</span>
            </div>
          </div>
          <div class="cond-data-item" *ngIf="CondominioSeleccionado.anio_construccion">
            <i class="pi pi-calendar cond-data-icon"></i>
            <div>
              <span class="cond-data-label">Año construcción</span>
              <span class="cond-data-value">{{ CondominioSeleccionado.anio_construccion }}</span>
            </div>
          </div>
          <div class="cond-data-item" *ngIf="CondominioSeleccionado.domicilio">
            <i class="pi pi-map-marker cond-data-icon"></i>
            <div>
              <span class="cond-data-label">Domicilio</span>
              <span class="cond-data-value">{{ CondominioSeleccionado.domicilio }}</span>
            </div>
          </div>
          <div class="cond-data-item" *ngIf="CondominioSeleccionado.email">
            <i class="pi pi-envelope cond-data-icon"></i>
            <div>
              <span class="cond-data-label">Email</span>
              <span class="cond-data-value">{{ CondominioSeleccionado.email }}</span>
            </div>
          </div>
          
          <div class="cond-data-item" *ngIf="CondominioSeleccionado.telefono_caseta">
            <i class="pi pi-shield cond-data-icon"></i>
            <div>
              <span class="cond-data-label">Tel. Caseta</span>
              <span class="cond-data-value">{{ CondominioSeleccionado.telefono_caseta }}</span>
            </div>
          </div>
          <div class="cond-data-item" *ngIf="CondominioSeleccionado.telefono_administracion">
            <i class="pi pi-phone cond-data-icon"></i>
            <div>
              <span class="cond-data-label">Tel. Administración</span>
              <span class="cond-data-value">{{ CondominioSeleccionado.telefono_administracion }}</span>
            </div>
          </div>
          
        </div>
      </div>

      <!-- Columna 2: Administración + Constructora -->
      <div class="cond-panel-card">
        <div class="cond-card-title"><i class="pi pi-users"></i> Administración</div>
        <div class="cond-data-item" *ngIf="CondominioSeleccionado.tipo_administracion" style="margin-bottom:12px">
          <i class="pi pi-briefcase cond-data-icon"></i>
          <div>
            <span class="cond-data-label">Tipo</span>
            <span class="cond-data-value">{{ CondominioSeleccionado.tipo_administracion }}</span>
          </div>
        </div>
        <div class="cond-admins" *ngIf="Administradores.length > 0">
          <div class="cond-admin-item" *ngFor="let admin of Administradores">
            <div class="cond-admin-avatar"><i class="pi pi-user"></i></div>
            <div class="cond-admin-info">
              <span class="cond-admin-nombre">{{ admin.nombre }}</span>
              <span class="cond-admin-email">{{ admin.email }}</span>
            </div>
          </div>
        </div>
        <div class="cond-no-admins" *ngIf="Administradores.length === 0">
          <i class="pi pi-info-circle me-1"></i> Sin administradores asignados
        </div>
        <div class="d-flex gap-2 mt-3 flex-wrap">
          <button pButton type="button" icon="pi pi-user-plus"
            label="Asignar Administrador"
            class="p-button-text p-button-success cond-btn-link"
            *ngIf="Administradores.length === 0"
            (click)="onAbrirPanelAdmin()">
          </button>
        </div>

        <div class="cond-divider"></div>
        <div class="cond-card-title"><i class="pi pi-building"></i> Constructora</div>
        <div class="cond-data-list">
          <div class="cond-data-item" *ngIf="CondominioSeleccionado.constructora">
            <i class="pi pi-home cond-data-icon"></i>
            <div>
              <span class="cond-data-label">Nombre</span>
              <span class="cond-data-value">{{ CondominioSeleccionado.constructora }}</span>
            </div>
          </div>
          <div class="cond-data-item" *ngIf="CondominioSeleccionado.constructora_telefono">
            <i class="pi pi-phone cond-data-icon"></i>
            <div>
              <span class="cond-data-label">Teléfono</span>
              <span class="cond-data-value">{{ CondominioSeleccionado.constructora_telefono }}</span>
            </div>
          </div>
          <div class="cond-data-item" *ngIf="CondominioSeleccionado.constructora_domicilio">
            <i class="pi pi-map-marker cond-data-icon"></i>
            <div>
              <span class="cond-data-label">Domicilio</span>
              <span class="cond-data-value">{{ CondominioSeleccionado.constructora_domicilio }}</span>
            </div>
          </div>
          <div class="cond-no-admins" *ngIf="!CondominioSeleccionado.constructora">
            <i class="pi pi-info-circle me-1"></i> Sin información de constructora
          </div>
        </div>
      </div>

      <!-- Columna 3: Documentos -->
      <div class="cond-panel-card">
        <div class="cond-card-title"><i class="pi pi-folder"></i> Documentos</div>
        <div class="cond-docs-grid">
          <a class="cond-doc-item" [class.cond-doc-available]="CondominioSeleccionado.archivo_acta_constitutiva"
            [href]="getArchivoUrl(CondominioSeleccionado, 'archivo_acta_constitutiva')"
            [target]="CondominioSeleccionado.archivo_acta_constitutiva ? '_blank' : null">
            <div class="cond-doc-icon"><i class="pi pi-file-pdf"></i></div>
            <span class="cond-doc-label">Acta Constitutiva</span>
            <span class="cond-doc-status">{{ CondominioSeleccionado.archivo_acta_constitutiva ? 'Disponible' : 'Sin archivo' }}</span>
          </a>
          <a class="cond-doc-item" [class.cond-doc-available]="CondominioSeleccionado.archivo_reglamento_interno"
            [href]="getArchivoUrl(CondominioSeleccionado, 'archivo_reglamento_interno')"
            [target]="CondominioSeleccionado.archivo_reglamento_interno ? '_blank' : null">
            <div class="cond-doc-icon"><i class="pi pi-file-pdf"></i></div>
            <span class="cond-doc-label">Reglamento Interno</span>
            <span class="cond-doc-status">{{ CondominioSeleccionado.archivo_reglamento_interno ? 'Disponible' : 'Sin archivo' }}</span>
          </a>
          <a class="cond-doc-item" [class.cond-doc-available]="CondominioSeleccionado.archivo_poliza_seguro"
            [href]="getArchivoUrl(CondominioSeleccionado, 'archivo_poliza_seguro')"
            [target]="CondominioSeleccionado.archivo_poliza_seguro ? '_blank' : null">
            <div class="cond-doc-icon"><i class="pi pi-shield"></i></div>
            <span class="cond-doc-label">Póliza de Seguro</span>
            <span class="cond-doc-status">{{ CondominioSeleccionado.archivo_poliza_seguro ? 'Disponible' : 'Sin archivo' }}</span>
          </a>
          <a class="cond-doc-item" [class.cond-doc-available]="CondominioSeleccionado.archivo_planos"
            [href]="getArchivoUrl(CondominioSeleccionado, 'archivo_planos')"
            [target]="CondominioSeleccionado.archivo_planos ? '_blank' : null">
            <div class="cond-doc-icon"><i class="pi pi-map"></i></div>
            <span class="cond-doc-label">Planos</span>
            <span class="cond-doc-status">{{ CondominioSeleccionado.archivo_planos ? 'Disponible' : 'Sin archivo' }}</span>
          </a>
        </div>
      </div>

    </div>
  </div>

  <!-- EMPTY -->
  <div class="cond-empty" *ngIf="Condominios.length === 0">
    <i class="pi pi-building"></i>
    <p>No hay condominios registrados</p>
    <button pButton type="button" icon="pi pi-plus" label="Agregar condominio"
      class="p-button-success" (click)="onCondominioEditar()">
    </button>
  </div>

</div>

  </div><!-- /vista carrusel -->


<!-- DIÁLOGO EDICIÓN -->
<p-dialog [(visible)]="mostrarDialogoEdicion" [modal]="true" [draggable]="false"
  [style]="{ width: '700px' }" styleClass="hoose-dialogo"
  [header]="frmCondominio?.get('id_condominio')?.value > 0 ? 'Editar Condominio' : 'Nuevo Condominio'"
  [closable]="false">
  <form [formGroup]="frmCondominio" *ngIf="frmCondominio">
    <div class="row g-3">

      <!-- Imagen -->
      <div class="col-12 text-center">
        <div class="cond-img-preview" (click)="srcImagen && onMostrarImagenPreview(srcImagen)">
          <img [src]="srcImagen || './assets/img/imagen_no_disponible.png'" />
        </div>
        <div class="d-flex justify-content-center gap-2 mt-2">
          <label for="txtImagenArchivo" class="cond-btn-file">
            <i class="pi pi-folder-open"></i> Imagen
          </label>
          <input type="file" id="txtImagenArchivo" class="d-none" accept=".png,.jpg,.jpeg"
            (change)="onImagenSeleccionada($event)"/>
          <button *ngIf="frmCondominio.get('archivo_imagen').value" pButton type="button"
            icon="pi pi-undo" class="p-button-text p-button-secondary"
            pTooltip="Cancelar selección" (click)="onImagenSeleccionadaCancelar()">
          </button>
          <button *ngIf="frmCondominio.get('imagen').value" pButton type="button"
            icon="pi pi-trash" class="p-button-text p-button-danger"
            pTooltip="Eliminar imagen" (click)="onImagenEliminada()">
          </button>
        </div>
      </div>

      <!-- Datos básicos -->
      <div class="col-12">
        <label class="frm-label">Nombre del Condominio *</label>
        <input pInputText formControlName="condominio" class="w-100" placeholder="Nombre"/>
      </div>
      <div class="col-12">
        <label class="frm-label">Domicilio *</label>
        <textarea pInputTextarea formControlName="domicilio" class="w-100" rows="2"></textarea>
      </div>
      <div class="col-6">
        <label class="frm-label">Tipo</label>
        <p-dropdown formControlName="tipo" [options]="tiposCondominio" optionValue="value"
          placeholder="Selecciona" styleClass="w-100" [showClear]="true">
        </p-dropdown>
      </div>
      <div class="col-6">
        <label class="frm-label">Metros Cuadrados</label>
        <input pInputText formControlName="metros_cuadrados" class="w-100" placeholder="m²" type="number"/>
      </div>
      <div class="col-6">
        <label class="frm-label">Email</label>
        <input pInputText formControlName="email" class="w-100" placeholder="correo@ejemplo.com"/>
      </div>

      <div class="col-6">
        <label class="frm-label">Año Construcción</label>
        <input pInputText formControlName="anio_construccion" class="w-100" placeholder="2000" maxlength="4"/>
      </div>


      <!-- Teléfonos adicionales -->
      <div class="col-6">
        <label class="frm-label">Tel. Administración</label>
        <p-inputMask formControlName="telefono_administracion" mask="(9999) 99-9999" styleClass="w-100"></p-inputMask>
      </div>
      <div class="col-6">
        <label class="frm-label">Tel. Caseta</label>
        <p-inputMask formControlName="telefono_caseta" mask="(9999) 99-9999" styleClass="w-100"></p-inputMask>
      </div>



      <!-- Constructora -->
      <div class="col-12"><div class="cond-form-section-title">Constructora</div></div>
      <div class="col-8">
        <label class="frm-label">Nombre</label>
        <input pInputText formControlName="constructora" class="w-100"/>
      </div>
      <div class="col-4">
        <label class="frm-label">Teléfono</label>
        <p-inputMask formControlName="constructora_telefono" mask="(9999) 99-9999" styleClass="w-100"></p-inputMask>
      </div>
      <div class="col-12">
        <label class="frm-label">Domicilio Constructora</label>
        <textarea pInputTextarea formControlName="constructora_domicilio" class="w-100" rows="2"></textarea>
      </div>

      <!-- Documentos -->
      <div class="col-12"><div class="cond-form-section-title">Documentos</div></div>
      <div class="col-6">
        <label class="frm-label">Acta Constitutiva</label>
        <div class="cond-file-input">
          <label class="cond-btn-file" for="fileActa">
            <i class="pi pi-upload"></i>
            {{ frmCondominio.get('archivo_acta_constitutiva').value?.name || (CondominioSeleccionado?.archivo_acta_constitutiva ? 'Reemplazar' : 'Seleccionar') }}
          </label>
          <input type="file" class="d-none" accept=".pdf"
            id="fileActa" (change)="onArchivoSeleccionado($event, 'archivo_acta_constitutiva')"/>
        
<small *ngIf="CondominioSeleccionado?.archivo_acta_constitutiva" class="text-muted d-block mt-1"><i class="pi pi-check-circle me-1" style="color:#10b981"></i>Archivo cargado: {{ CondominioSeleccionado.archivo_acta_constitutiva }}</small>
</div>
      </div>
      <div class="col-6">
        <label class="frm-label">Reglamento Interno</label>
        <div class="cond-file-input">
          <label class="cond-btn-file" for="fileReglamento">
            <i class="pi pi-upload"></i>
            {{ frmCondominio.get('archivo_reglamento_interno').value?.name || (CondominioSeleccionado?.archivo_reglamento_interno ? 'Reemplazar' : 'Seleccionar') }}
          </label>
          <input type="file" class="d-none" accept=".pdf"
            id="fileReglamento" (change)="onArchivoSeleccionado($event, 'archivo_reglamento_interno')"/>
        
<small *ngIf="CondominioSeleccionado?.archivo_reglamento_interno" class="text-muted d-block mt-1"><i class="pi pi-check-circle me-1" style="color:#10b981"></i>Archivo cargado: {{ CondominioSeleccionado.archivo_reglamento_interno }}</small>
</div>
      </div>
      <div class="col-6">
        <label class="frm-label">Póliza de Seguro</label>
        <div class="cond-file-input">
          <label class="cond-btn-file" for="filePoliza">
            <i class="pi pi-upload"></i>
            {{ frmCondominio.get('archivo_poliza_seguro').value?.name || (CondominioSeleccionado?.archivo_poliza_seguro ? 'Reemplazar' : 'Seleccionar') }}
          </label>
          <input type="file" class="d-none" accept=".pdf"
            id="filePoliza" (change)="onArchivoSeleccionado($event, 'archivo_poliza_seguro')"/>
        
<small *ngIf="CondominioSeleccionado?.archivo_poliza_seguro" class="text-muted d-block mt-1"><i class="pi pi-check-circle me-1" style="color:#10b981"></i>Archivo cargado: {{ CondominioSeleccionado.archivo_poliza_seguro }}</small>
</div>
      </div>
      <div class="col-6">
        <label class="frm-label">Planos</label>
        <div class="cond-file-input">
          <label class="cond-btn-file" for="filePlanos">
            <i class="pi pi-upload"></i>
            {{ frmCondominio.get('archivo_planos').value?.name || (CondominioSeleccionado?.archivo_planos ? 'Reemplazar' : 'Seleccionar') }}
          </label>
          <input type="file" class="d-none" accept=".pdf,.dwg,.dxf"
            id="filePlanos" (change)="onArchivoSeleccionado($event, 'archivo_planos')"/>
        
<small *ngIf="CondominioSeleccionado?.archivo_planos" class="text-muted d-block mt-1"><i class="pi pi-check-circle me-1" style="color:#10b981"></i>Archivo cargado: {{ CondominioSeleccionado.archivo_planos }}</small>
</div>
      </div>

    </div>
  </form>
  <ng-template pTemplate="footer">
    <button pButton type="button" label="Cancelar"
      class="p-button-text hoose-btn-cancelar" (click)="onCondominioCancelar()">
    </button>
    <button pButton type="button" icon="pi pi-check" label="Guardar"
      class="hoose-btn-guardar" (click)="onCondominioGuardar()">
    </button>
  </ng-template>
</p-dialog>


<!-- DIÁLOGO ASIGNAR ADMINISTRADOR -->
<p-dialog *ngIf="mostrarPanelAdmin" [(visible)]="mostrarPanelAdmin" [modal]="true" [draggable]="false"
  [style]="{ width: '420px' }" styleClass="hoose-dialogo"
  header="Asignar Administrador">
  <ng-template pTemplate="content">
    <p style="font-size:0.8rem;color:#8a8f9e;margin-bottom:12px">
      Selecciona un administrador sin condominio asignado para vincularlo a
      <b style="color:#f0f0f0">{{ CondominioSeleccionado?.condominio }}</b>.
    </p>
    <label class="frm-label">Administrador</label>
    <p-dropdown [options]="AdminsSinAsignar" [(ngModel)]="adminSeleccionado"
      placeholder="Selecciona un administrador" [filter]="true"
      filterBy="label" styleClass="w-100" [showClear]="true"
      [appendTo]="'body'"
      emptyMessage="No hay administradores disponibles">
    </p-dropdown>
  </ng-template>
  <ng-template pTemplate="footer">
    <button pButton type="button" label="Cancelar"
      class="p-button-text hoose-btn-cancelar" (click)="mostrarPanelAdmin=false">
    </button>
    <button pButton type="button" icon="pi pi-check" label="Asignar"
      class="hoose-btn-guardar" [disabled]="!adminSeleccionado"
      (click)="onAsignarAdministrador()">
    </button>
  </ng-template>
</p-dialog>

<!-- Preview imagen -->
<p-dialog [(visible)]="mostrarImagenPreview" [modal]="true" [draggable]="false"
  [style]="{ width: '75vw' }" header="Imagen del Condominio" styleClass="hoose-dialogo">
  <img [src]="srcImagenPreview" style="width:100%;border-radius:8px"/>
</p-dialog>
