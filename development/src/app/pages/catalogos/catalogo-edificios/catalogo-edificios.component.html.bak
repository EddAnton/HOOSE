<div class="hoose-tabla-wrapper" style="margin: 16px 16px 0 0;">

  <!-- Toolbar -->
  <div class="hoose-tabla-toolbar" style="align-items:stretch;gap:16px">
    <!-- Izquierda: KPI card -->
    <div class="hoose-kpi-card hoose-kpi-pink" style="margin:0">
      <div class="hoose-kpi-icon"><i class="pi pi-building"></i></div>
      <div class="hoose-kpi-body">
        <span class="hoose-kpi-label">Total Edificios</span>
        <span class="hoose-kpi-value">{{ EdificiosFiltrados.length }}</span>
        <span class="hoose-kpi-sub">Activos: <b>{{ kpiActivos }}</b> &nbsp;|&nbsp; Inactivos: <b>{{ kpiInactivos }}</b></span>
      </div>
    </div>
    <!-- Derecha: botón nuevo arriba + filtros abajo -->
    <div class="d-flex flex-column gap-2 justify-content-between" style="flex:1;min-width:0">
      <div class="d-flex justify-content-end">
        <button pButton type="button" icon="pi pi-plus" label="Nuevo Edificio" class="hoose-btn-nuevo" pTooltip="Agregar edificio" tooltipPosition="left" (click)="onEdificioEditar()"></button>
      </div>
      <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
        <div class="hoose-tabla-search">
          <i class="pi pi-search"></i>
          <input type="text" placeholder="Buscar edificio..." (input)="ptEdificios.filterGlobal($event.target.value, 'contains')" />
        </div>
        <select *ngIf="esSuperAdminSinCondominio" class="hoose-filtro-select" [(ngModel)]="filtroCondominio">
          <option [ngValue]="null">Condominio</option>
          <option *ngFor="let c of condominiosLista" [ngValue]="c.value">{{ c.label }}</option>
        </select>
        <select class="hoose-filtro-select" [(ngModel)]="filtroTipo">
          <option [ngValue]="null">Tipo</option>
          <option *ngFor="let t of tiposEdificio" [ngValue]="t">{{ t }}</option>
        </select>
        <select class="hoose-filtro-select" [(ngModel)]="filtroEstatus">
          <option [ngValue]="null">Estatus</option>
          <option [ngValue]="1">Activo</option>
          <option [ngValue]="0">Inactivo</option>
        </select>
        <button pButton type="button" icon="pi pi-times" class="hoose-btn-clear" pTooltip="Limpiar filtros" tooltipPosition="left" (click)="limpiarFiltros(); hlpPrimeNGTable.reset(ptEdificios)"></button>
      </div>
    </div>
  </div>

  <!-- Tabla -->
  <div class="hoose-tabla-container" style="overflow-x:auto">
    <p-table
      #ptEdificios
      [value]="EdificiosFiltrados"
      [globalFilterFields]="EdificiosFilter"
      [rowHover]="true"
      [showCurrentPageReport]="true"
      [paginator]="Edificios.length > 0"
      [rows]="20"
      dataKey="id_edificio"
      styleClass="hoose-table"
      currentPageReportTemplate="Mostrando {first} - {last} de {totalRecords}"
      [rowsPerPageOptions]="[10,20,50]"
    >
      <ng-template pTemplate="header">
        <tr>
          <th *ngIf="esSuperAdminSinCondominio" class="hoose-th" style="min-width:140px;white-space:nowrap">Condominio</th>
          <th class="hoose-th" style="min-width:100px;white-space:nowrap">Tipo</th>
          <th class="hoose-th" style="min-width:180px;white-space:nowrap">Nombre</th>
          <th class="hoose-th text-center" style="min-width:90px;white-space:nowrap">Unidades</th>
          <th class="hoose-th text-center" style="min-width:90px;white-space:nowrap">Niveles</th>
          <th class="hoose-th text-center" style="min-width:90px;white-space:nowrap">Estatus</th>
          <th class="hoose-th text-center" style="min-width:110px;white-space:nowrap">Acciones</th>
        </tr>
      </ng-template>
      <ng-template pTemplate="body" let-Edificio>
        <tr class="hoose-tr" (click)="onEdificioDetalles(Edificio)">
          <td *ngIf="esSuperAdminSinCondominio" class="hoose-td">
            <span class="hoose-cond-pill" [ngStyle]="{'color': getCondominioColor(Edificio.condominio_nombre), 'background': getCondominioColor(Edificio.condominio_nombre) + '18'}">{{ Edificio.condominio_nombre || '—' }}</span>
          </td>
          <td class="hoose-td">
            <span class="hoose-tipo-pill">{{ Edificio.tipo || 'Edificio' }}</span>
          </td>
          <td class="hoose-td"><strong class="hoose-nombre">{{ Edificio.edificio }}</strong></td>
          <td class="hoose-td text-center"><span class="hoose-num">{{ Edificio.numero_unidades || 0 }}</span></td>
          <td class="hoose-td text-center"><span class="hoose-num">{{ Edificio.numero_niveles || 0 }}</span></td>
          <td class="hoose-td text-center">
            <span class="hoose-estatus-pill {{ Edificio.estatus == 1 ? 'activo' : 'inactivo' }}" style="cursor:pointer"
              (click)="$event.stopPropagation(); onEdificioAlternarEstatus(Edificio)"
              pTooltip="{{ Edificio.estatus == 1 ? 'Deshabilitar' : 'Habilitar' }}" tooltipPosition="top">
              <span class="hoose-estatus-dot"></span>{{ Edificio.estatus == 1 ? 'Activo' : 'Inactivo' }}
            </span>
          </td>
          <td class="hoose-td text-center" (click)="$event.stopPropagation()">
            <button pButton type="button" icon="pi pi-eye" class="hoose-btn-accion" pTooltip="Ver detalles" tooltipPosition="top" (click)="onEdificioDetalles(Edificio)"></button>
            <button pButton type="button" icon="pi pi-pencil" class="hoose-btn-accion" pTooltip="Editar" tooltipPosition="top" (click)="onEdificioEditar(Edificio.id_edificio)"></button>
            <button *ngIf="esSuperAdmin" pButton type="button" icon="pi pi-trash" class="hoose-btn-accion" style="color:#ef4444 !important" pTooltip="Eliminar" tooltipPosition="top" (click)="$event.stopPropagation(); onEdificioEliminar(Edificio)"></button>
          </td>
        </tr>
      </ng-template>
      <ng-template pTemplate="emptymessage">
        <tr><td [attr.colspan]="esSuperAdminSinCondominio ? 7 : 6" class="hoose-empty">Sin registros.</td></tr>
      </ng-template>
    </p-table>
  </div>
</div>

<!-- Diálogo de inserción y edición -->
<p-dialog
	[(visible)]="mostrarDialogoEdicionEdificio"
	[breakpoints]="{ '991px': '80vw', '640px': '96vw' }"
	[style]="{ width: '50vw' }"
	[modal]="true"
	[closable]="false"
	header="{{ Edificio && Edificio.id_edificio == 0 ? 'Nuevo Edificio / Torre' : 'Editar Edificio / Torre' }}"
	styleClass="hoose-dialogo"
>
	<ng-template pTemplate="content">
				<form id="frmEdificio" class="mt-1" [formGroup]="frmEdificio" autocomplete="off">
			<!-- Contenedor: Condominio -->
			<div class="hoose-section" *ngIf="esSuperAdminSinCondominio">
				<div class="hoose-section-title">Condominio</div>
				<div class="row">
					<div class="col-12 col-md-6">
						<label>Condominio <span class="text-danger">*</span></label>
						<select class="form-control" formControlName="fk_id_condominio">
							<option [value]="null" disabled>Selecciona el condominio</option>
							<option *ngFor="let c of condominiosLista" [value]="c.value">{{ c.label }}</option>
						</select>
					</div>
				</div>
			</div>
			<!-- Contenedor: Datos del Edificio -->
			<div class="hoose-section">
				<div class="hoose-section-title">Datos del Edificio / Torre</div>
				<div class="row">
					<div class="col-12 col-md-4">
						<label>Tipo <span class="text-danger">*</span></label>
						<select class="form-control" formControlName="tipo">
							<option *ngFor="let t of tiposEdificio" [value]="t">{{ t }}</option>
						</select>
					</div>
					<div class="col-12 col-md-8">
						<label>Nombre <span class="text-danger">*</span></label>
						<input pInputText type="text" formControlName="edificio" class="uppercase w-100" autofocus (focus)="hlpApp.selectAllContent($event)" />
					</div>
				</div>
				<div class="row mt-2">
					<div class="col-12 col-md-6">
						<label>Número de niveles / pisos</label>
						<input pInputText type="number" formControlName="numero_niveles" class="w-100" min="0" />
					</div>
					<div class="col-12 col-md-6">
						<label>Número de unidades</label>
						<input pInputText type="number" formControlName="numero_unidades" class="w-100" min="0" />
					</div>
				</div>
				<div class="row mt-2">
					<div class="col-12">
						<label>Plano del edificio</label>
						<input type="file" class="form-control form-control-sm" accept=".pdf,.png,.jpg,.jpeg" (change)="onPlanoSeleccionado($event)" />
						<small *ngIf="Edificio?.plano_archivo" class="text-muted d-block mt-1"><i class="pi pi-check-circle me-1" style="color:#10b981"></i>Archivo cargado: {{ Edificio.plano_archivo }}</small>
					</div>
				</div>
			</div>
		</form>
	</ng-template>
	<ng-template pTemplate="footer">
		<!-- Botón Guardar -->
		<button
			pButton
			type="button"
			label="Guardar"
			icon="pi pi-save"
			class="p-button-raised p-button-info me-sm-1"
			pTooltip="Almacenar la información"
			tooltipPosition="top"
			[disabled]="!frmEdificio.valid"
			(click)="onEdificioGuardar()"
		></button>
		<!-- Botón Cancelar -->
		<button
			pButton
			type="button"
			label="Cancelar"
			icon="pi pi-times"
			class="p-button-raised p-button-warning ml-2"
			pTooltip="Cancelar el proceso"
			tooltipPosition="top"
			(click)="onEdificioCancelar()"
		></button>
	</ng-template>
</p-dialog>

<!-- Diálogo Detalles del Edificio -->
<p-dialog
  styleClass="hoose-detalle-dialog"
  [breakpoints]="{ '991px': '90vw', '640px': '98vw' }"
  [style]="{ width: '70vw', maxWidth: '900px' }"
  *ngIf="mostrarDialogoDetallesEdificio" [(visible)]="mostrarDialogoDetallesEdificio"
  [modal]="true"
  [showHeader]="false"
  [contentStyle]="{'padding': '0', 'background': '#12121f', 'border-radius': '16px'}"
>
<ng-template pTemplate="content">
<div class="hoose-detalle">
  <div class="hoose-detalle-header">
    <div class="d-flex align-items-center">
      <div class="hoose-detalle-icon-header" style="background:rgba(245,158,11,0.15)"><i class="pi pi-building" style="color:#f59e0b"></i></div>
      <div class="ms-3">
        <h4 class="mb-0 text-white">{{ EdificioDetalle?.edificio }}</h4>
        <small class="text-muted">{{ EdificioDetalle?.tipo || 'Edificio' }} — {{ EdificioDetalle?.condominio_nombre }}</small>
      </div>
    </div>
    <div class="d-flex align-items-center gap-2">
      <button pButton type="button" icon="pi pi-pencil" label="Editar" class="p-button-outlined p-button-sm" style="color:#ccc;border-color:#444" (click)="mostrarDialogoDetallesEdificio=false; onEdificioEditar(EdificioDetalle?.id_edificio)"></button>
      <button pButton type="button" icon="pi pi-times" class="p-button-text p-button-sm" style="color:#888" (click)="mostrarDialogoDetallesEdificio=false"></button>
    </div>
  </div>

  <div class="row g-3 p-3">
    <div class="col-12 col-md-4">
      <div class="hoose-detalle-card text-center p-4">
        <div class="mx-auto mb-3" style="width:110px;height:110px;border-radius:50%;border:3px solid #f59e0b;display:flex;align-items:center;justify-content:center;background:rgba(245,158,11,0.08)">
          <i class="pi pi-building" style="color:#f59e0b;font-size:3rem"></i>
        </div>
        <div class="mb-2" style="cursor:pointer" (click)="onEdificioAlternarEstatus(EdificioDetalle)" pTooltip="{{ EdificioDetalle?.estatus == 1 ? 'Deshabilitar' : 'Habilitar' }} edificio" tooltipPosition="top">
          <span class="hoose-badge-activo" *ngIf="EdificioDetalle?.estatus == 1"><span class="hoose-dot-green"></span> Activo</span>
          <span class="hoose-badge-inactivo" *ngIf="EdificioDetalle?.estatus != 1"><span class="hoose-dot-red"></span> Inactivo</span>
        </div>
        <h5 class="text-white mb-1">{{ EdificioDetalle?.edificio }}</h5>
        <small class="text-muted">{{ EdificioDetalle?.tipo || 'Edificio' }}</small>
      </div>
    </div>

    <div class="col-12 col-md-8">
      <!-- Info general -->
      <div class="hoose-detalle-card p-3 mb-3">
        <div class="d-flex flex-wrap gap-3">
          <div class="d-flex align-items-center gap-2">
            <div class="hoose-info-icon" style="background:rgba(233,30,138,0.15)"><i class="pi pi-building" style="color:#e91e8a"></i></div>
            <div><small class="text-muted d-block">Condominio</small><strong class="text-white">{{ EdificioDetalle?.condominio_nombre }}</strong></div>
          </div>
          <div class="d-flex align-items-center gap-2">
            <div class="hoose-info-icon" style="background:rgba(59,130,246,0.15)"><i class="pi pi-th-large" style="color:#3b82f6"></i></div>
            <div><small class="text-muted d-block">Unidades</small><strong class="text-white">{{ UnidadesDelEdificio?.length || 0 }} de {{ EdificioDetalle?.numero_unidades || 0 }}</strong></div>
          </div>
          <div class="d-flex align-items-center gap-2">
            <div class="hoose-info-icon" style="background:rgba(16,185,129,0.15)"><i class="pi pi-bars" style="color:#10b981"></i></div>
            <div><small class="text-muted d-block">Niveles / Pisos</small><strong class="text-white">{{ EdificioDetalle?.numero_niveles || 0 }}</strong></div>
          </div>
        </div>
      </div>

      <!-- Plano del edificio -->
      <div class="hoose-detalle-card p-3 mb-3" *ngIf="EdificioDetalle?.plano_archivo">
        <a [href]="'http://api.residenciales.hoose.mx/uploads/edificios/' + EdificioDetalle.id_edificio + '/' + EdificioDetalle.plano_archivo" target="_blank" class="d-flex align-items-center gap-2" style="text-decoration:none">
          <div class="hoose-info-icon-sm" style="background:rgba(245,158,11,0.15)"><i class="pi pi-file-pdf" style="color:#f59e0b"></i></div>
          <h6 class="text-white mb-0" style="color:#f59e0b !important">Plano del Edificio <i class="pi pi-external-link ms-1" style="font-size:0.75rem"></i></h6>
        </a>
      </div>

      <!-- Unidades del edificio -->
      <div class="hoose-detalle-card p-3">
        <div class="d-flex align-items-center gap-2 mb-3"><div class="hoose-info-icon-sm" style="background:rgba(59,130,246,0.15)"><i class="pi pi-th-large" style="color:#3b82f6"></i></div><h6 class="text-white mb-0">Unidades</h6></div>
        <div *ngIf="UnidadesDelEdificio.length === 0" class="text-muted">No hay unidades registradas</div>
        <div *ngFor="let unidad of UnidadesDelEdificio" class="d-flex align-items-center gap-3 p-2 mb-2" style="background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.05);border-radius:10px">
          <div class="hoose-info-icon" style="background:rgba(59,130,246,0.15)"><i class="pi pi-home" style="color:#3b82f6"></i></div>
          <div class="flex-grow-1">
            <strong class="text-white">{{ unidad.unidad }}</strong><br/>
            <small class="text-muted">{{ unidad.propietario_nombre || 'Sin propietario' }}</small>
          </div>
          <div class="text-end">
            <span *ngIf="unidad.modo" style="background:rgba(139,92,246,0.15);color:#8b5cf6;padding:3px 10px;border-radius:15px;font-size:0.7rem;font-weight:600">{{ unidad.modo }}</span>
          </div>
          <div>
            <span class="hoose-dot-green" *ngIf="unidad.estatus == 1" style="width:10px;height:10px"></span>
            <span class="hoose-dot-red" *ngIf="unidad.estatus != 1" style="width:10px;height:10px"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
</ng-template>
</p-dialog>
